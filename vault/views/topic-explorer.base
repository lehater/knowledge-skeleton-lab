# Контекстная таблица: открывать в sidebar рядом с активной Knowledge или встраивать в заметку.
# В обычной вкладке this указывает на сам .base, поэтому список может быть пуст.
filters:
  and:
    - file.inFolder("knowledge/entries")
    - file.ext == "md"
    - type == "knowledge"
views:
  - type: table
    name: Связаны через in_topic с активной Knowledge
    filters:
      - 'list(in_topic).contains(this)'
    order:
      - name
      - in_topic
