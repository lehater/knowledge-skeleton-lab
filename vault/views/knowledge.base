filters:
  and:
    - file.inFolder("knowledge/entries")
    - file.ext == "md"
    - type == "knowledge"
views:
  - type: table
    name: Knowledge skeletons
    order:
      - file.name
      - name
      - kind
      - lifecycle
      - review_status
      - in_topic
      - broader
  - type: table
    name: Proposed knowledge
    filters:
      - 'review_status == "proposed"'
    order:
      - file.name
      - in_topic
      - kind
  - type: table
    name: Components (kind)
    filters:
      - 'kind == "component"'
    order:
      - name
      - kind
      - in_topic
      - part_of
      - realizes
  - type: table
    name: Mechanisms (kind)
    filters:
      - 'kind == "mechanism"'
    order:
      - name
      - kind
      - in_topic
      - executes
      - manages
